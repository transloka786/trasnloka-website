  },
  "dependencies": {
    "framer-motion": "^11.15.0",
    "next": "15.5.25",
    "nodemailer": "10.0.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "0.35.4",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^7.0.2",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/three": "^0.180.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "postcss": "8.5.23"
  }
